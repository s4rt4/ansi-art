{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ANSI Art",
  "version": "0.1.0",
  "identifier": "dev.ansiart.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ANSI Art",
        "width": 1280,
        "height": 820,
        "minWidth": 860,
        "minHeight": 540,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": { "bundleMediaFramework": false }
    }
  }
}
